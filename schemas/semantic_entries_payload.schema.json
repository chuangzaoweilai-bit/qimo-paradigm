{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/qimo-paradigm/schemas/semantic_entries_payload.schema.json",
  "title": "SemanticEntriesPayload",
  "description": "Payload file read by Container 1 from /app/output/semantic_entries.json.",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id"],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

